# TruckPanel configuration. The installer generates /opt/truckpanel/.env (mode 0600).
# Never commit a real .env.

# Public URL users open in the browser (Origin checks, Secure cookies).
APP_URL=https://panel.example.com

# Panel listens only on loopback; the host reverse proxy forwards to it.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# postgres://user:pass@host:5432/db  (production)
# pglite://./.pglite                 (local development without Docker)
DATABASE_URL=postgres://truckpanel:CHANGE_ME@postgres:5432/truckpanel
POSTGRES_PASSWORD=CHANGE_ME

# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# One-time token for creating the first administrator:  openssl rand -base64 36
# Remove it after setup; the endpoint is closed anyway once any user exists.
INITIAL_SETUP_TOKEN=

TRUST_PROXY_HOPS=1
LOG_LEVEL=info
