{
  "name": "truckpanel",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:panel": "pnpm --filter @truckpanel/panel dev",
    "dev:web": "pnpm --filter @truckpanel/web dev",
    "test:installer": "bats installer/tests",
    "test:installer:docker": "bash installer/tests/run-in-docker.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bats": "^1.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
